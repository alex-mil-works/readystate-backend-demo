{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "corepack enable && yarn install --immutable",
  "buildCommand": "yarn build",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "src/index.ts": {
      "includeFiles": "artifacts/**"
    }
  }
}
